# infrastructure/kubernetes/configmap.yml are development placeholders only;
# real environments supply them via External Secrets or a cloud secret store.
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.jks
application-local.yml
application-local.properties
secrets.yml

